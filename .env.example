APP_NAME="VexaHost Client"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8054

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Akun admin pertama (dibuat/diselaraskan oleh seeder)
ADMIN_NAME="Owner VexaHost"
ADMIN_EMAIL=vexahostcloudtech@gmail.com
ADMIN_PASSWORD=ganti-password-ini

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_vexahost-client-dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=vexahost_client_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="vexahostcloudtech@gmail.com"
MAIL_FROM_NAME="VexaHost"

# Login dengan Google (OAuth client yang sama dengan project vexahost)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# VexaHost WA Gateway (fallback — nilai utama diatur di Admin Panel > Pengaturan Perusahaan)
WA_API_URL=https://wa.vexahostcloud.my.id/api/v1/messages/text
WA_API_KEY=
WA_WEBHOOK_SECRET=
WA_ADMIN_PHONES=085808749131
ADMIN_NOTIFICATION_EMAIL=vexahostcloudtech@gmail.com

# Xendit Payment Gateway
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
INTERNAL_WEBHOOK_SECRET=vexahost_internal_xnd_token_38c92a

VITE_APP_NAME="${APP_NAME}"

